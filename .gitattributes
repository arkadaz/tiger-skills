# Force LF in the repo AND on checkout for every text file.
#
# Why this exists: this is a cross-platform plugin whose files are consumed by
# Unix-y tooling -- the Workflow runtime (Node), shell hooks (#!/usr/bin/env bash),
# Robot Framework, and python helpers. On Windows clones with core.autocrlf=true
# and no .gitattributes, git checked these out as CRLF, which:
#   - injected \r (0x0D) control chars into workflow scripts, so the Workflow
#     approval dialog rejected them ("control characters that would be hidden in
#     the approval dialog") and /tiger-workflow-dev could never launch;
#   - broke shell-hook shebangs (#!/usr/bin/env bash\r -> "bad interpreter").
# eol=lf overrides core.autocrlf, so installs are LF everywhere.
* text=auto eol=lf

# Explicit for the executable / machine-consumed formats.
*.js       text eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.robot    text eol=lf
*.resource text eol=lf
*.log      text eol=lf

# Binary assets -- never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
